# LLM API (OpenAI-compatible endpoint)
# - Có thể là OpenAI thật, OpenRouter, Together, Groq, vLLM/Ollama, ...
# - Hoặc bất kỳ provider nào expose chuẩn /v1/chat/completions
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o

# Tuỳ chọn: chạy không headless để xem AI thao tác
HEADLESS=false
