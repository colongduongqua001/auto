# LLM API (OpenAI-compatible endpoint)
# - Có thể là OpenAI thật, OpenRouter, Together, Groq, vLLM/Ollama, ...
# - Hoặc bất kỳ provider nào expose chuẩn /v1/chat/completions
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o

# Tuỳ chọn: chạy không headless để xem AI thao tác
HEADLESS=false

# Tuỳ chọn: 1 số LLM gateway chặn User-Agent mặc định của OpenAI SDK,
# override ở đây nếu gặp lỗi 403 "Your request was blocked".
# LLM_USER_AGENT=auto-browser-agent/0.1

